<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="Jorgito_coitito">

    <xacro:property name="scale" value="1.0"/>

    <xacro:property name="chasis_length" value="${0.256*scale}"/>
    <xacro:property name="chasis_width"  value="${0.148*scale}"/>
    <xacro:property name="chasis_height" value="${0.022*scale}"/>
    <xacro:property name="wheel_radius"  value="${0.033*scale}"/>
    <xacro:property name="wheel_width"   value="${0.022*scale}"/>
    <xacro:property name="wheel_x_off"   value="${0.128*scale}"/>
    <xacro:property name="wheel_y_off"   value="${0.085*scale}"/>
    <xacro:property name="chasis_mass" value="0.5"/>
    <xacro:property name="wheel_mass" value="0.05"/>
    <xacro:property name="steer_mass" value="0.01"/>

    <material name="blue"><color rgba="0.0 0.3 1.0 1.0"/></material>
    <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>

    <xacro:macro name="box_inertia" params="m l w h">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${m}"/>
            <inertia ixx="${m*(w*w+h*h)/12}" ixy="0.0" ixz="0.0"
                     iyy="${m*(l*l+h*h)/12}" iyz="0.0"
                     izz="${m*(w*w+l*l)/12}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${m}"/>
            <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0.0" ixz="0.0"
                     iyy="${m*(3*r*r+l*l)/12}" iyz="0.0"
                     izz="${m*r*r/2}"/>
        </inertial>
    </xacro:macro>

    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <geometry><box size="${chasis_length} ${chasis_width} ${chasis_height}"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry><box size="${chasis_length} ${chasis_width} ${chasis_height}"/></geometry>
        </collision>
        <xacro:box_inertia m="${chasis_mass}" l="${chasis_length}" w="${chasis_width}" h="${chasis_height}"/>
    </link>

    <xacro:macro name="wheel" params="prefix x_off y_off">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="${prefix}_wheel_material">
                    <color rgba="1.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_off} ${y_off} 0" rpy="-1.5708 0 0"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="steer_wheel" params="prefix x_off y_off">
        <link name="${prefix}_steer_link">
            <inertial>
                <mass value="${steer_mass}"/>
                <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
                         iyy="0.00001" iyz="0.0" izz="0.00001"/>
            </inertial>
        </link>

        <joint name="${prefix}_steer_joint" type="revolute">
            <parent link="base_link"/>
            <child link="${prefix}_steer_link"/>
            <origin xyz="${x_off} ${y_off} 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="0.05" friction="0.05"/>
            <limit lower="-0.6" upper="0.6" effort="10" velocity="5"/>
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="${prefix}_wheel_material">
                    <color rgba="1.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="${prefix}_steer_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="0.01" friction="0.01"/>
        </joint>
    </xacro:macro>

    <xacro:wheel prefix="rear_left"   x_off="${-wheel_x_off}" y_off="${wheel_y_off}"/>
    <xacro:wheel prefix="rear_right"  x_off="${-wheel_x_off}" y_off="${-wheel_y_off}"/>
    <xacro:steer_wheel prefix="front_left"  x_off="${wheel_x_off}" y_off="${wheel_y_off}"/>
    <xacro:steer_wheel prefix="front_right" x_off="${wheel_x_off}" y_off="${-wheel_y_off}"/>


</robot>