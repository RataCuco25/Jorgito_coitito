<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>ackerman_vehicle_description</name>
  <version>0.0.0</version>

  <description>
    Description and simulation of an Ackermann vehicle with cameras,
    RGB-D camera, LiDAR and IMU sensors for Gazebo Harmonic and ROS 2 Jazzy.
  </description>

  <maintainer email="luishector.m.delrazo25@gmail.com">Luis Héctor Muñoz Del Razo</maintainer>
  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Gazebo Harmonic / ROS-Gazebo integration -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Message types used by the bridge -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <!-- Optional display launch -->
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <!-- Tests -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
